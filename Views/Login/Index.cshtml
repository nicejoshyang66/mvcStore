@{
    ViewData["Title"] = "MayAP Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-Hant">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MayAP Login</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/navigation.css">

    <style>
            .error-message {
                color: blue;
            }
    </style>

</head>

<body>

    <div id="login-app" class="login-wrapper" data-login-url="@Url.Content("~/api/auth/login")">

        <div class="login-box">

            <div class="login-header">
                <img src="~/images/apps/applogo.png" alt="logo" class="login-logo">
                <span>GoodJob</span>
            </div>

            <div class="login-body">
                <form method="post" v-on:submit.prevent="mysubmit">
                    @Html.AntiForgeryToken()

                    <div class="login-row">

                        <label for="userId" class="login-label">帳號：</label>

                        <div class="input-group">
                            <input type="text" id="userId" v-model="userId" name="userId" class="form-control"
                                   autocomplete="off" required>
                            <span class="input-group-text">👤</span>
                        </div>

                    </div>

                    <div class="login-row">

                        <label for="password" class="login-label">密碼：</label>

                        <div class="input-group">
                            <input type="password" id="password" v-model="password" name="password" class="form-control"
                                   autocomplete="current-password" required>

                            <span class="input-group-text">🔒</span>
                        </div>
                    </div>
                    <div class="form-check remember-row">
                        <input type="checkbox" class="form-check-input" id="rememberMe" v-model="rememberMe"
                               name="rememberMe" value="true" />

                        <label class="form-check-label" for="rememberMe">
                            記住登入，下次不用重新輸入
                        </label>
                    </div>

                    <div class="d-grid mt-3">

                    
                        <button type="submit" v-bind:disabled="busy" class="btn btn-primary btn-login">
                            登入
                        </button>
                    </div>

                    <div v-cloak v-if="error" class="error-message" role="alert">{{ error }}</div>

                </form>
            </div>

        </div>
    </div>


    <script src="~/lib/vue/vue.global.prod.js"></script>
    <script src="~/js/login.js"></script>

</body>

</html>
