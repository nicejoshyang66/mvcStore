{
  "path-intellisense.mappings": {
    "~": "${workspaceFolder}/wwwroot"
  },
  "files.associations": {
    "*.cshtml": "aspnetcorerazor"
  },
  "[aspnetcorerazor]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp",
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.quickSuggestions": {
      "strings": true
    }
  }
}
