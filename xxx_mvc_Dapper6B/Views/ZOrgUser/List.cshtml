@model List<mvc_Dapper.Models.Entity.z_org_user>

@{
    var codeUser = ViewBag.CodeUser?.ToString()?.ToUpper();

    string? title = codeUser == "M"
        ? "管帳戶資料維護" : "登入帳戶資料維護";
}

<h1>@title</h1>

<p>
    <a asp-action="Create" asp-route-code_user="@ViewBag.CodeUser" class="btn btn-success btn-sm">
        <i class="bi bi-plus-circle"></i> Create New
    </a>
</p>

@if (Model != null && Model.Any())
{
    <table class="table table-bordered table-hover">
        <thead class="table-primary">
            <tr>
                <th class="w50">密碼</th>
                <th>@Html.DisplayNameFor(model => model[0].is_enabled)</th>
                <th>@Html.DisplayNameFor(model => model[0].mno)</th>
                <th>@Html.DisplayNameFor(model => model[0].mname)</th>
                <th>@Html.DisplayNameFor(model => model[0].tel_user)</th>
                <th>@Html.DisplayNameFor(model => model[0].mobile_user)</th>
                <th>@Html.DisplayNameFor(model => model[0].email_user)</th>
                <th>@Html.DisplayNameFor(model => model[0].remark)</th>
                <th>功能</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {

                <tr>
                    <td class="text-center">
                        <button type="button" class="btn btn-warning btn-sm btnChangePassword" data-rowid="@item.rowid"
                                data-mno="@item.mno" data-mname="@item.mname">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </td>

                    <td>@Html.DisplayFor(x => item.is_enabled)</td>
                    <td>@Html.DisplayFor(x => item.mno)</td>
                    <td>@Html.DisplayFor(x => item.mname)</td>
                    <td>@Html.DisplayFor(x => item.tel_user)</td>
                    <td>@Html.DisplayFor(x => item.mobile_user)</td>
                    <td>@Html.DisplayFor(x => item.email_user)</td>
                    <td>@Html.DisplayFor(x => item.remark)</td>
                    <td class="text-nowrap">
                        <a asp-action="Edit" asp-route-rowid="@item.rowid" asp-route-code_user="@ViewBag.CodeUser"
                           class="btn btn-outline-primary btn-sm me-1">
                            Edit
                        </a>
                        <a asp-action="Delete" asp-route-rowid="@item.rowid" asp-route-code_user="@ViewBag.CodeUser"
                           class="btn btn-outline-danger btn-sm me-1">
                            Delete
                        </a>
                    </td>
                </tr>


            }




        </tbody>


    </table>
}
else
{
    <div class="alert alert-info">
        目前沒有資料。
    </div>
}

<form id="changePasswordForm">
    @Html.AntiForgeryToken()

    <input type="hidden" id="rowid" name="rowid" />
    <input type="hidden" id="code_user" name="code_user" value="@ViewBag.CodeUser" />

    <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-lock-fill"></i> 密碼變更
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                @* *@

                <div class="modal-body">
                    <div class="alert alert-secondary py-2">
                        帳號：
                        <span id="UserInfo" class="fw-bold"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">新的密碼</label>
                        <input type="password" id="NewPassword" name="NewPassword" class="form-control"
                               autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">確認密碼</label>
                        <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control"
                               autocomplete="off" />
                    </div>

                    <div id="PasswordMessage" class="text-danger"></div>
                </div>


                @* *@
                <div class="modal-footer">
                    <button type="button" id="btnSavePassword" class="btn btn-primary">
                        確定變更
                    </button>

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        關閉視窗
                    </button>
                </div>

            </div>
        </div>
    </div>

</form>

@section Scripts {
    <script>

        var changePasswordModal;

        document.addEventListener("DOMContentLoaded", function () {

            changePasswordModal = new bootstrap.Modal(
                document.getElementById("changePasswordModal")
            );

            var buttons = document.querySelectorAll(".btnChangePassword");

            buttons.forEach(function (btn) {

                btn.addEventListener("click", function () {

                    var rowid = this.dataset.rowid;
                    var mno = this.dataset.mno || "";
                    var mname = this.dataset.mname || "";

                    document.getElementById("rowid").value = rowid;
                    document.getElementById("NewPassword").value = "";
                    document.getElementById("ConfirmPassword").value = "";
                    document.getElementById("PasswordMessage").innerText = "";
                    document.getElementById("UserInfo").innerText = mno + " " + mname;

                    changePasswordModal.show();

                });

            });


            // var btnSavePassword = document.getElementById("btnSavePassword");

            var btnSavePassword = document.getElementById("btnSavePassword");

            btnSavePassword.addEventListener("click", function () {

                var newPassword = document.getElementById("NewPassword").value;
                var confirmPassword = document.getElementById("ConfirmPassword").value;
                var msg = document.getElementById("PasswordMessage");

                msg.innerText = "";

                if (newPassword.trim() === "") {
                    msg.innerText = "請輸入新密碼";
                    return;
                }

                if (confirmPassword.trim() === "") {
                    msg.innerText = "請輸入確認密碼";
                    return;
                }

                if (newPassword !== confirmPassword) {
                    msg.innerText = "兩次輸入的密碼不一致";
                    return;
                }

                var form = document.getElementById("changePasswordForm");
                var formData = new FormData(form);

                @* fetch("@Url.Action("ChangePassword", "ZOrgUser")", {
                    method: "POST",
                    body: formData
                }) *@

                fetch("@Url.Action("ChangePassword","ZOrgUser")",{
                    method:"post",
                    body:formData
                })
                    .then(function(response){
                        return response.json();
                    })

                    .then(function(result){
                        if(result.success){
                            alert(result.message);
                            changePasswordModal.hide();
                        } else {
                            msg.innerText=result.message;
                        }
                    })
                    .catch(function(){
                        msg.innerText="系統發生錯誤，密碼未變更。";
                    });
            });

        });

    </script>
}