@using mvc_Dapper.Models.Entity

@model mvc_Dapper.Models.ViewModel.ListVM<z_demo_vendor>

@{
    ViewData["Title"]="廠商資料維護";
}

<h3 class="mb-3">廠商資料維護</h3>

<div class="d-flex justify-content-between align-items-center mb-3">

    <div>
        <a asp-action="Create" class="btn btn-primary">
            新增廠商
        </a>
    </div>

    @await Html.PartialAsync("_PageSizeSelector",Model.PageInfo)

</div>


<table class="table table-bordered table-hover table-striped">
    <thead class="table-light">
        <tr>
            <th style="width:80px;">啟用</th>
            <th>廠商編號</th>
            <th>廠商簡稱</th>
            <th>廠商名稱</th>
            <th>統一編號</th>
            <th>電話</th>
            <th>負責人</th>
            <th>聯絡人</th>
            <th style="width:220px;">功能</th>
        </tr>
    </thead>

    <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="9" class="text-center text-muted">
                    目前沒有資料
                </td>
            </tr>
        }
        else
        {
            foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        @if (item.is_enabled)
                        {
                            <span class="badge bg-success">啟用</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">停用</span>
                        }
                    </td>

                    <td>@item.mno</td>
                    <td>@item.msname</td>
                    <td>@item.mname</td>
                    <td>@item.no_serial</td>
                    <td>@item.tel_company</td>
                    <td>@item.name_charge</td>
                    <td>@item.name_contact</td>

                    <td>
                        <a asp-action="Details" asp-route-id="@item.rowid" class="btn btn-sm btn-info me-1">
                            瀏覽
                        </a>

                        <a asp-action="Edit" asp-route-id="@item.rowid" class="btn btn-sm btn-warning me-1">
                            修改
                        </a>

                        <a asp-action="Delete" asp-route-id="@item.rowid" class="btn btn-sm btn-danger">
                            刪除
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@await Html.PartialAsync("_Pager",Model.PageInfo)