@model mvc_Dapper.Models.Entity.z_demo_vendor

@{
    ViewData["Title"] = "新增廠商";
}

<h3 class="mb-3">新增廠商</h3>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card">
        <div class="card-body">

            <div class="row mb-3">
                <div class="col-md-2">
                    <label asp-for="is_enabled" class="form-label"></label>
                    <div class="form-check">
                        <input asp-for="is_enabled" class="form-check-input" />
                        <label class="form-check-label" asp-for="is_enabled">啟用</label>
                    </div>
                </div>

                <div class="col-md-5">
                    <label asp-for="mno" class="form-label"></label>
                    <input asp-for="mno" class="form-control" />
                    <span asp-validation-for="mno" class="text-danger"></span>
                </div>

                <div class="col-md-5">
                    <label asp-for="msname" class="form-label"></label>
                    <input asp-for="msname" class="form-control" />
                    <span asp-validation-for="msname" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="mname" class="form-label"></label>
                    <input asp-for="mname" class="form-control" />
                    <span asp-validation-for="mname" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="no_serial" class="form-label"></label>
                    <input asp-for="no_serial" class="form-control" />
                    <span asp-validation-for="no_serial" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="name_invoice" class="form-label"></label>
                    <input asp-for="name_invoice" class="form-control" />
                    <span asp-validation-for="name_invoice" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="tel_company" class="form-label"></label>
                    <input asp-for="tel_company" class="form-control" />
                    <span asp-validation-for="tel_company" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="name_charge" class="form-label"></label>
                    <input asp-for="name_charge" class="form-control" />
                    <span asp-validation-for="name_charge" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="name_contact" class="form-label"></label>
                    <input asp-for="name_contact" class="form-control" />
                    <span asp-validation-for="name_contact" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="adr_company" class="form-label"></label>
                <input asp-for="adr_company" class="form-control" />
                <span asp-validation-for="adr_company" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="adr_invoice" class="form-label"></label>
                <input asp-for="adr_invoice" class="form-control" />
                <span asp-validation-for="adr_invoice" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="remark" class="form-label"></label>
                <textarea asp-for="remark" class="form-control" rows="3"></textarea>
                <span asp-validation-for="remark" class="text-danger"></span>
            </div>

        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">存檔</button>

        <a asp-action="List" class="btn btn-secondary">
            返回
        </a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}