@model mvc_Dapper.Models.Entity.z_demo_vendor

@{
    ViewData["Title"] = "刪除廠商";
}

<h3 class="mb-3 text-danger">刪除廠商</h3>

<div class="alert alert-danger">
    確定要刪除這筆廠商資料嗎？
</div>

<div class="card">
    <div class="card-body">

        <table class="table table-bordered">
            <tr>
                <th style="width:180px;">RowId</th>
                <td>@Model.rowid</td>
            </tr>

            <tr>
                <th>啟用</th>
                <td>
                    @if (Model.is_enabled)
                    {
                        <span class="badge bg-success">啟用</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">停用</span>
                    }
                </td>
            </tr>

            <tr>
                <th>廠商編號</th>
                <td>@Model.mno</td>
            </tr>

            <tr>
                <th>廠商簡稱</th>
                <td>@Model.msname</td>
            </tr>

            <tr>
                <th>廠商名稱</th>
                <td>@Model.mname</td>
            </tr>

            <tr>
                <th>統一編號</th>
                <td>@Model.no_serial</td>
            </tr>

            <tr>
                <th>電話</th>
                <td>@Model.tel_company</td>
            </tr>

            <tr>
                <th>負責人</th>
                <td>@Model.name_charge</td>
            </tr>

            <tr>
                <th>聯絡人</th>
                <td>@Model.name_contact</td>
            </tr>
        </table>

    </div>
</div>

<form asp-action="DeleteConfirm" method="post" class="mt-3">
    @Html.AntiForgeryToken()

    <input type="hidden" name="rowid" value="@Model.rowid" />

    <button type="submit" class="btn btn-danger">
        確定刪除
    </button>

    <a asp-action="List" class="btn btn-secondary">
        取消
    </a>
</form>