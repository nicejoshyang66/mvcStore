@model mvc_Dapper.Models.Entity.z_demo_vendor

@{
    ViewData["Title"] = "瀏覽廠商";
}

<h3 class="mb-3">瀏覽廠商</h3>

<div class="card">
    <div class="card-body">

        <table class="table table-bordered">
            <tr>
                <th style="width:180px;">RowId</th>
                <td>@Model.rowid</td>
            </tr>

            <tr>
                <th>啟用</th>
                <td>
                    @if (Model.is_enabled)
                    {
                        <span class="badge bg-success">啟用</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">停用</span>
                    }
                </td>
            </tr>

            <tr>
                <th>廠商編號</th>
                <td>@Model.mno</td>
            </tr>

            <tr>
                <th>廠商簡稱</th>
                <td>@Model.msname</td>
            </tr>

            <tr>
                <th>廠商名稱</th>
                <td>@Model.mname</td>
            </tr>

            <tr>
                <th>統一編號</th>
                <td>@Model.no_serial</td>
            </tr>

            <tr>
                <th>發票名稱</th>
                <td>@Model.name_invoice</td>
            </tr>

            <tr>
                <th>電話</th>
                <td>@Model.tel_company</td>
            </tr>

            <tr>
                <th>負責人</th>
                <td>@Model.name_charge</td>
            </tr>

            <tr>
                <th>聯絡人</th>
                <td>@Model.name_contact</td>
            </tr>

            <tr>
                <th>公司地址</th>
                <td>@Model.adr_company</td>
            </tr>

            <tr>
                <th>發票地址</th>
                <td>@Model.adr_invoice</td>
            </tr>

            <tr>
                <th>備註</th>
                <td>@Model.remark</td>
            </tr>
        </table>

    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.rowid" class="btn btn-warning">
        修改
    </a>

    <a asp-action="List" class="btn btn-secondary">
        返回
    </a>
</div>