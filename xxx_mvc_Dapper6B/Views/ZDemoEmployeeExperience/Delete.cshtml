@model mvc_Dapper.Models.Entity.z_demo_employee_experience

@{
    ViewData["Title"] = "刪除經歷";
}

<h3 class="mb-3 text-danger">刪除經歷</h3>

<div class="alert alert-danger">
    確定要刪除這筆經歷資料嗎？
</div>

<table class="table table-bordered">
    <tr>
        <th style="width:150px;">員工編號</th>
        <td>@Model.employee_no</td>
    </tr>
    <tr>
        <th>公司名稱</th>
        <td>@Model.name_company</td>
    </tr>
    <tr>
        <th>職稱</th>
        <td>@Model.title_company</td>
    </tr>
</table>

<form asp-action="DeleteConfirm" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="rowid" value="@Model.rowid" />
    <input type="hidden" name="employeeNo" value="@Model.employee_no" />

    <button type="submit" class="btn btn-danger">確定刪除</button>

    <a asp-action="List" asp-route-employeeNo="@Model.employee_no" class="btn btn-secondary">
        返回
    </a>
</form>