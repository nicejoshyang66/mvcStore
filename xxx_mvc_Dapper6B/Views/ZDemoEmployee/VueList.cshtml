@{
    ViewData["Title"] = "員工資料清單（Vue）";
}

<div id="employeeVueApp" v-cloak>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h3 class="mb-1">員工資料清單（Vue）</h3>
            <small class="text-muted">本頁由 Vue 管理資料載入與分頁</small>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("Create", "ZDemoEmployee")" class="btn btn-danger">
                新增員工
            </a>
            <label for="vuePageSize" class="text-nowrap">每頁筆數</label>
            <select id="vuePageSize"
                    v-model.number="pageSize"
                    v-on:change="changePageSize"
                    class="form-select"
                    style="width: 90px;">
                <option v-for="size in pageSizes" v-bind:key="size" v-bind:value="size">
                    {{ size }}
                </option>
            </select>
        </div>
    </div>

    <div v-if="errorMessage" class="alert alert-danger" role="alert">
        {{ errorMessage }}
        <button type="button" class="btn btn-sm btn-outline-danger ms-2" v-on:click="loadEmployees">
            重新載入
        </button>
    </div>

    <div class="table-responsive position-relative">
        <div v-if="loading"
             class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-white bg-opacity-75"
             style="z-index: 1; min-height: 160px;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">載入中</span>
            </div>
        </div>

        <table class="table table-bordered table-hover table-striped align-middle">
            <thead class="table-light">
                <tr>
                    <th>啟用</th>
                    <th>員工編號</th>
                    <th>姓名</th>
                    <th>身分證字號</th>
                    <th>部門</th>
                    <th>職稱</th>
                    <th>出生日期</th>
                    <th>性別</th>
                    <th class="text-end">底薪</th>
                    <th>電話</th>
                    <th style="min-width: 330px;">操作</th>
                </tr>
            </thead>
            <tbody>
                <tr v-if="!loading && items.length === 0">
                    <td colspan="11" class="text-center text-muted">查無員工資料</td>
                </tr>
                <tr v-for="item in items" v-bind:key="item.rowid">
                    <td>
                        <span v-if="item.is_enabled" class="badge bg-success">啟用</span>
                        <span v-else class="badge bg-secondary">停用</span>
                    </td>
                    <td>{{ item.mno }}</td>
                    <td>{{ item.mname }}</td>
                    <td>{{ item.no_serial }}</td>
                    <td>{{ item.dept_no }}</td>
                    <td>{{ item.title_no }}</td>
                    <td>{{ formatDate(item.date_birth) }}</td>
                    <td>{{ genderText(item.code_gender) }}</td>
                    <td class="text-end">{{ formatSalary(item.salary_base) }}</td>
                    <td>{{ item.tel_home }}</td>
                    <td>
                        <a v-bind:href="employeeUrl('Details', item.rowid)" class="btn btn-sm btn-info me-1">明細</a>
                        <a v-bind:href="employeeUrl('Edit', item.rowid)" class="btn btn-sm btn-warning me-1">修改</a>
                        <a v-bind:href="relatedUrl('ZDemoEmployeeSchool', item.mno)"
                           class="btn btn-sm btn-outline-primary me-1">學歷</a>
                        <a v-bind:href="relatedUrl('ZDemoEmployeeExperience', item.mno)"
                           class="btn btn-sm btn-outline-success me-1">經歷</a>
                        <a v-bind:href="employeeUrl('Delete', item.rowid)" class="btn btn-sm btn-danger">刪除</a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div v-if="totalCount > 0" class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
        <div>
            共 {{ totalCount }} 筆，顯示第 {{ startItem }} - {{ endItem }} 筆
        </div>
        <nav aria-label="員工清單分頁">
            <ul class="pagination mb-0">
                <li class="page-item" v-bind:class="{ disabled: page === 1 || loading }">
                    <button class="page-link" type="button" v-on:click="goToPage(1)">第一頁</button>
                </li>
                <li class="page-item" v-bind:class="{ disabled: page === 1 || loading }">
                    <button class="page-link" type="button" v-on:click="goToPage(page - 1)">上一頁</button>
                </li>
                <li v-for="pageNumber in visiblePages"
                    v-bind:key="pageNumber"
                    class="page-item"
                    v-bind:class="{ active: pageNumber === page }">
                    <button class="page-link" type="button" v-on:click="goToPage(pageNumber)">
                        {{ pageNumber }}
                    </button>
                </li>
                <li class="page-item" v-bind:class="{ disabled: page === totalPages || loading }">
                    <button class="page-link" type="button" v-on:click="goToPage(page + 1)">下一頁</button>
                </li>
                <li class="page-item" v-bind:class="{ disabled: page === totalPages || loading }">
                    <button class="page-link" type="button" v-on:click="goToPage(totalPages)">最後頁</button>
                </li>
            </ul>
        </nav>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    <script>
        const employeeListDataUrl = '@Url.Action("VueListData", "ZDemoEmployee")';
        const employeeBaseUrl = '@Url.Action("VueList", "ZDemoEmployee")'.replace(/\/VueList\/?$/i, '');

        Vue.createApp({
            data() {
                return {
                    items: [],
                    page: 1,
                    pageSize: 10,
                    pageSizes: [5, 10, 20, 50],
                    totalCount: 0,
                    totalPages: 0,
                    loading: false,
                    errorMessage: ''
                };
            },
            computed: {
                startItem() {
                    return this.totalCount === 0 ? 0 : (this.page - 1) * this.pageSize + 1;
                },
                endItem() {
                    return Math.min(this.page * this.pageSize, this.totalCount);
                },
                visiblePages() {
                    const start = Math.max(1, this.page - 2);
                    const end = Math.min(this.totalPages, this.page + 2);
                    return Array.from({ length: Math.max(0, end - start + 1) }, (_, index) => start + index);
                }
            },
            mounted() {
                this.loadEmployees();
            },
            methods: {
                async loadEmployees() {
                    this.loading = true;
                    this.errorMessage = '';

                    try {
                        const query = new URLSearchParams({
                            page: this.page,
                            pageSize: this.pageSize
                        });
                        const response = await fetch(`${employeeListDataUrl}?${query}`, {
                            headers: { 'Accept': 'application/json' }
                        });

                        if (!response.ok) {
                            throw new Error(`HTTP ${response.status}`);
                        }

                        const result = await response.json();
                        this.items = result.items;
                        this.page = result.page;
                        this.pageSize = result.pageSize;
                        this.totalCount = result.totalCount;
                        this.totalPages = result.totalPages;
                    } catch (error) {
                        console.error(error);
                        this.errorMessage = '員工資料載入失敗，請稍後再試。';
                    } finally {
                        this.loading = false;
                    }
                },
                goToPage(targetPage) {
                    if (this.loading || targetPage < 1 || targetPage > this.totalPages || targetPage === this.page) {
                        return;
                    }
                    this.page = targetPage;
                    this.loadEmployees();
                },
                changePageSize() {
                    this.page = 1;
                    this.loadEmployees();
                },
                employeeUrl(action, id) {
                    return `${employeeBaseUrl}/${action}/${encodeURIComponent(id)}`;
                },
                relatedUrl(controller, employeeNo) {
                    return `${employeeBaseUrl.replace(/\/ZDemoEmployee$/i, '')}/${controller}/List?employeeNo=${encodeURIComponent(employeeNo ?? '')}`;
                },
                formatDate(value) {
                    return value ? value.substring(0, 10) : '';
                },
                formatSalary(value) {
                    return value == null ? '' : new Intl.NumberFormat('zh-TW').format(value);
                },
                genderText(value) {
                    return value === 'M' ? '男' : value === 'F' ? '女' : '';
                }
            }
        }).mount('#employeeVueApp');
    </script>
}

<style>
    [v-cloak] {
        display: none;
    }
</style>
