@model mvc_Dapper.Models.Entity.z_demo_employee

@{
    ViewData["Title"] = "編輯員工";
}

<h3 class="mb-3">編輯員工</h3>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="rowid" />

    @await Html.PartialAsync("_Form", Model)

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">儲存</button>
        <a asp-action="List" class="btn btn-secondary">返回</a>
    </div>
</form>

<hr />

<div class="mb-3">
    <a asp-controller="ZDemoEmployeeSchool"
       asp-action="List"
       asp-route-employeeNo="@Model.mno"
       class="btn btn-outline-primary">
        維護學歷資料
    </a>

    <a asp-controller="ZDemoEmployeeExperience"
       asp-action="List"
       asp-route-employeeNo="@Model.mno"
       class="btn btn-outline-success">
        維護經歷資料
    </a>
</div>