@model mvc_Dapper.Models.ViewModel.ListVM<mvc_Dapper.Models.Entity.z_demo_employee>

@{
    ViewData["Title"] = "員工資料維護";
}

<h3 class="mb-3">員工資料維護</h3>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Create" class="btn btn-danger">
        新增員工
    </a>

    @await Html.PartialAsync("_PageSizeSelector", Model.PageInfo)
</div>

<table class="table table-bordered table-hover table-striped">
    <thead class="table-light">
        <tr>
            <th>啟用</th>
            <th>員工編號</th>
            <th>姓名</th>
            <th>身分證號</th>
            <th>部門</th>
            <th>職稱</th>
            <th>生日</th>
            <th>性別</th>
            <th class="text-end">底薪</th>
            <th>電話</th>
            <th style="width:300px;">功能</th>
        </tr>
    </thead>

    <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="11" class="text-center text-muted">
                    目前沒有資料
                </td>
            </tr>
        }
        else
        {
            foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        @if (item.is_enabled)
                        {
                            <span class="badge bg-success">啟用</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">停用</span>
                        }
                    </td>

                    <td>@item.mno</td>
                    <td>@item.mname</td>
                    <td>@item.no_serial</td>
                    <td>@item.dept_no</td>
                    <td>@item.title_no</td>
                    <td>
                        @(item.date_birth.HasValue ? item.date_birth.Value.ToString("yyyy-MM-dd") : "")

                    </td>
                    <td>
                        @if (item.code_gender == "M")
                        {
                            <span>男</span>
                        }
                        else if (item.code_gender == "F")
                        {
                            <span>女</span>
                        }
                    </td>
                    <td class="text-end">
                        @(item.salary_base.HasValue ? item.salary_base.Value.ToString("N0") : "")
                    </td>
                    <td>@item.tel_home</td>

                    <td>
                        <a asp-action="Details" asp-route-id="@item.rowid" class="btn btn-sm btn-info me-1">明細</a>

                        <a asp-action="Edit" asp-route-id="@item.rowid" class="btn btn-sm btn-warning me-1">編輯</a>

                        <a asp-controller="ZDemoEmployeeSchool"
                           asp-action="List"
                           asp-route-employeeNo="@item.mno"
                           class="btn btn-sm btn-outline-primary me-1">
                            學歷
                        </a>

                        <a asp-controller="ZDemoEmployeeExperience"
                           asp-action="List"
                           asp-route-employeeNo="@item.mno"
                           class="btn btn-sm btn-outline-success me-1">
                            經歷
                        </a>

                        <a asp-action="Delete" asp-route-id="@item.rowid" class="btn btn-sm btn-danger">
                            刪除
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@await Html.PartialAsync("_Pager", Model.PageInfo)