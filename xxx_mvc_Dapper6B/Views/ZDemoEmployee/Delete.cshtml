@model mvc_Dapper.Models.Entity.z_demo_employee

@{
    ViewData["Title"] = "刪除員工";
}

<h3 class="mb-3 text-danger">刪除員工</h3>

<div class="alert alert-danger">
    確定要刪除這筆員工資料嗎？
</div>

<table class="table table-bordered">
    <tr>
        <th style="width:150px;">
            @Html.DisplayNameFor(model => model.is_enabled)
        </th>
        <td>
            @if (Model.is_enabled)
            {
                <span>啟用</span>
            }
            else
            {
                <span>停用</span>
            }
        </td>
    </tr>

    <tr>
        <th>
            @Html.DisplayNameFor(model => model.mno)
        </th>
        <td>
            @Html.DisplayFor(model => model.mno)
        </td>
    </tr>

    <tr>
        <th>
            @Html.DisplayNameFor(model => model.mname)
        </th>
        <td>
            @Html.DisplayFor(model => model.mname)
        </td>
    </tr>

    <tr>
        <th>
            @Html.DisplayNameFor(model => model.no_serial)
        </th>
        <td>
            @Html.DisplayFor(model => model.no_serial)
        </td>
    </tr>

    <tr>
        <th>
            @Html.DisplayNameFor(model => model.dept_no)
        </th>
        <td>
            <span style="display:inline-block; width:80px;">
                @Html.DisplayFor(model => model.dept_no)
            </span>

            <span>
                @ViewBag.DepartmentName
            </span>
        </td>
    </tr>

    <tr>
        <th>
            @Html.DisplayNameFor(model => model.title_no)
        </th>
        <td>
            <span style="display:inline-block; width:80px;">
                @Html.DisplayFor(model => model.title_no)
            </span>

            <span>
                @ViewBag.TitleName
            </span>
        </td>
    </tr>

    <tr>
        <th>
            @Html.DisplayNameFor(model => model.date_birth)
        </th>
        <td>
            @(Model.date_birth.HasValue ? Model.date_birth.Value.ToString("yyyy-MM-dd") : "")
        </td>
    </tr>

    <tr>
        <th>
            @Html.DisplayNameFor(model => model.code_gender)
        </th>
        <td>
            @if (Model.code_gender == "M")
            {
                <span>男</span>
            }
            else if (Model.code_gender == "F")
            {
                <span>女</span>
            }
        </td>
    </tr>

    <tr>
        <th>
            @Html.DisplayNameFor(model => model.salary_base)
        </th>
        <td>
            @(Model.salary_base.HasValue ? Model.salary_base.Value.ToString("N0") : "")
        </td>
    </tr>

    <tr>
        <th>
            @Html.DisplayNameFor(model => model.tel_home)
        </th>
        <td>
            @Html.DisplayFor(model => model.tel_home)
        </td>
    </tr>

    <tr>
        <th>
            @Html.DisplayNameFor(model => model.adr_home)
        </th>
        <td>
            @Html.DisplayFor(model => model.adr_home)
        </td>
    </tr>

    <tr>
        <th>
            @Html.DisplayNameFor(model => model.remark)
        </th>
        <td>
            @Html.DisplayFor(model => model.remark)
        </td>
    </tr>
</table>

<form asp-action="DeleteConfirm" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="rowid" value="@Model.rowid" />

    <button type="submit" class="btn btn-danger">
        確定刪除
    </button>

    <a asp-action="List" class="btn btn-secondary">
        返回
    </a>
</form>