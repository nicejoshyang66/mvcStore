<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - mvc_vm_Dapper4</title>
    @* <link rel="stylesheet" href="~/mvc_vm_Dapper4.styles.css" asp-append-version="true" /> *@
    <link rel="stylesheet" href="~/AdminLteA/dist/css/adminlte.css" />
    <!--begin::Fonts-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fontsource/source-sans-3@5.0.12/index.css"
          integrity="sha256-tXJfXfp6Ewt1ilPzLDtQnJV4hclT9XuaZUKyUvmyr+Q=" crossorigin="anonymous" media="print"
          onload="this.media = 'all'" />
    <!--end::Fonts-->
    <!--begin::Third Party Plugin(Bootstrap Icons)-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
          crossorigin="anonymous" />
    <!--end::Third Party Plugin(Bootstrap Icons)-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!--begin::Required Plugin(AdminLTE)-->
    @* <link rel="stylesheet" href="./css/adminlte.css" /> *@
    <!--end::Required Plugin(AdminLTE)-->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet"> *@

</head>

<body>
    <div class="app-wrapper">
        <!--begin::Header-->
        <nav class="app-header navbar navbar-expand bg-info">
            <!--begin::Container-->
            <div class="container-fluid">
                <!--begin::Start Navbar Links-->
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
                            <i class="bi bi-list"></i>
                        </a>
                    </li>
                    <li class="nav-item d-none d-sm-inline-block">
                        <a asp-controller="Home" asp-action="Index" class="nav-link">首頁</a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto">
                    <li class="nav-item dropdown">
                        <a class="nav-link" data-bs-toggle="dropdown" href="#">
                            <i class="fas fa-user"></i> 使用者
                        </a>
                        <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end">

                            <a asp-controller="Login" asp-action="Logout" class="dropdown-item">
                                <i class="fas fa-sign-out-alt me-2"></i>登出系統
                            </a>
                            <div class="dropdown-divider"></div>

                            <a href="#" class="dropdown-item">
                                <i class="fas fa-key me-2"></i>重設密碼
                            </a>
                            <a href="#" class="dropdown-item">
                                <i class="fas fa-lock me-2"></i>權限授權
                            </a>
                        </div>
                    </li>
                </ul>
                <!--end::Start Navbar Links-->
            </div>
            <!--end::Container-->
        </nav>
        <!--end::Header-->
        <!--begin::Sidebar-->
        <aside class="app-sidebar bg-body-secondary shadow " data-bs-theme="dark">
            <!--begin::Sidebar Brand-->
            <div class="sidebar-brand bg-black">
                <!--begin::Brand Link-->
                <a href="#" class="brand-link">
                    <!--begin::Brand Image-->
                    <img src="/AdminLteA/dist/assets/img/AdminLTELogo.png" alt="Alternate Logo"
                         class="brand-image opacity-75 shadow" />
                    <!--end::Brand Image-->
                    <!--begin::Brand Text-->
                    <span class="brand-text fw-light">GoodJob</span>
                    <!--end::Brand Text-->
                </a>
                <!--end::Brand Link-->
            </div>
            <!--end::Sidebar Brand-->
            <!--begin::Sidebar Wrapper-->
            <!-- Sidebar -->
            <aside class="main-sidebar sidebar-dark-primary elevation-4">

 

                <!-- Sidebar -->
                <div class="sidebar">
                    @using Microsoft.AspNetCore.Http
                <!-- User panel -->
                    <div class="user-panel mt-3 pb-3 mb-3 d-flex">

                        @{
                            var loginUserId = Context.Session.GetString("LoginUserId");
                            var loginUserName = Context.Session.GetString("LoginUserName");
                        }

                        <div class="info">
                            <a href="#" class="d-block text-white">

                                登入者：
                                @((loginUserId ?? "").ToUpper())
                                -
                                @(loginUserName ?? "")

                            </a>
                        </div>


                    </div>

                    <!-- 🔥 動態 Menu start -->
                    @await Component.InvokeAsync("SideMenu")
                    <!-- 🔥 動態 Menu end -->
                </div>
            </aside>
            <!--end::Sidebar Wrapper-->
        </aside>
        <!--end::Sidebar-->
        <!-- begin: appmain -->
        <main class="app-main">

            <div class="container">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

        </main>

        <!-- end: appmain -->
        <!--begin::Footer-->
        <footer class="app-footer">
            <!--begin::To the end-->
            <div class="float-end d-none d-sm-inline"> version: 2026/4/11</div>
            <!--end::To the end-->
            <!--begin::Copyright-->
            <strong>
                Copyright &copy; 2014-2026&nbsp;
                <a href="#" class="text-decoration-none">GoodJob</a>.
            </strong>
            All rights reserved.
            <!--end::Copyright-->
        </footer>
        <!--end::Footer-->
    </div>


    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - mvc_vm_Dapper4 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

  

    <script>
            document.addEventListener("DOMContentLoaded", function () {

                const currentPath = window.location.pathname.toLowerCase();
                const firstOpenKey = "sidebar-first-open-done";

                // 先清掉所有子選單 active
                document.querySelectorAll(".sidebar-menu .nav-treeview .nav-link.active").forEach(link => {
                    link.classList.remove("active");
                });

                // ===== 只在第一次進入時，自動打開第一個主選單 =====
                if (!sessionStorage.getItem(firstOpenKey)) {
                    const firstMenu = document.querySelector(".sidebar-menu > .nav-item");
                    if (firstMenu) {
                        firstMenu.classList.add("menu-open");

                        const firstMenuLink = firstMenu.querySelector(":scope > .nav-link");
                        if (firstMenuLink) {
                            firstMenuLink.classList.add("active");
                        }
                    }

                    sessionStorage.setItem(firstOpenKey, "true");
                }

                // ===== 根據目前網址，自動標示目前子選單 =====
                document.querySelectorAll(".sidebar-menu .nav-treeview .nav-link[href]").forEach(link => {

                    const href = link.getAttribute("href");

                    if (!href || href === "#" || href.startsWith("javascript:")) return;

                    const linkPath = new URL(href, window.location.origin).pathname.toLowerCase();

                    if (linkPath === currentPath) {

                        // 子選單自己變 active
                        link.classList.add("active");

                        // 找到父層主選單
                        const parentTree = link.closest(".nav-treeview");
                        if (parentTree) {
                            const parentLi = parentTree.closest(".nav-item");

                            if (parentLi) {
                                parentLi.classList.add("menu-open");

                                const parentLink = parentLi.querySelector(":scope > .nav-link");
                                if (parentLink) {
                                    parentLink.classList.add("active");
                                }
                            }
                        }
                    }
                });

            });
    </script>

    <script>
            document.addEventListener("DOMContentLoaded", function () {

                const currentPath = window.location.pathname.toLowerCase();

                document.querySelectorAll("#navigation .nav-link[href]").forEach(function (link) {

                    const href = link.getAttribute("href");

                    if (!href || href === "#" || href.startsWith("javascript:")) {
                        return;
                    }

                    let linkPath = "";

                    try {
                        linkPath = new URL(href, window.location.origin).pathname.toLowerCase();
                    } catch (e) {
                        return;
                    }

                    if (linkPath === currentPath) {

                        // 目前頁面 active
                        link.classList.add("active");

                        // 往上找所有父層 nav-treeview，逐層展開
                        let currentTree = link.closest(".nav-treeview");

                        while (currentTree) {
                            currentTree.style.display = "block";

                            const parentLi = currentTree.closest(".nav-item");
                            if (parentLi) {
                                parentLi.classList.add("menu-open");

                                const parentLink = parentLi.querySelector(":scope > .nav-link");
                                if (parentLink) {
                                    parentLink.classList.add("active");
                                }
                            }

                            currentTree = parentLi
                                ? parentLi.closest(".nav-treeview")
                                : null;
                        }
                    }
                });

            });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/AdminLteA/dist/js/adminlte.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
</body>

</html>
