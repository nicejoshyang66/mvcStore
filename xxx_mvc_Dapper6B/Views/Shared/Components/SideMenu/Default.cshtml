@model List<mvc_Dapper.Models.Entity.z_sys_program>

@functions {

    string GetMenuUrl(mvc_Dapper.Models.Entity.z_sys_program item)
    {
        if (!string.IsNullOrWhiteSpace(item.controllername) &&
            !string.IsNullOrWhiteSpace(item.actionname))
        {
            // 有帶參數
            if (!string.IsNullOrWhiteSpace(item.routename))
            {
                return $"/{item.controllername}/{item.actionname}?{item.routename}";
            }

            // 一般網址
            return $"/{item.controllername}/{item.actionname}";
        }

        return "#";
    }
}

<nav class="mt-2">
    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="navigation" aria-label="Main navigation"
        data-accordion="false" id="navigation">

        @foreach (var parent in Model)
        {
            <li class="nav-item">
                <a href="#" class="nav-link">
                    <i class="nav-icon fas fa-folder"></i>
                    <p>
                        @* @Html.Raw(parent.rowid) *@
                        @Html.Raw(parent.mname)
                        <i class="nav-arrow bi bi-chevron-right "></i>
                    </p>
                </a>

                <ul class="nav nav-treeview">
                    @foreach (var child in parent.Children)
                    {

                        var childUrl = GetMenuUrl(child);
                        
                        <li class="nav-item">
                            <a href="@childUrl" class="nav-link">
                                <i class="nav-icon fas fa-edit"></i>
                                <p>
                                    @* @Html.Raw(child.rowid) *@
                                    @Html.Raw(child.mname)
                                </p>
                            </a>
                        </li>
                    }
                </ul>
            </li>
        }

    </ul>
</nav>

