@model mvc_Dapper.Models.Vm.ZSysProgramVm

@{
    ViewData["Title"] = "ListDet";
}


<h2 class="mb-3">Master 資料</h2>

<div class="master-card">
    <table class="table master-table mb-0">
        <tbody>

            <tr>
                <td class="master-title">代號</td>
                <td>@Model.Mas?.mno</td>
                <td class="master-title">名稱</td>
                <td>@Model.Mas?.mname</td>
            </tr>

            <tr>
                <td class="master-title">類別</td>
                <td>@Model.Mas?.code_name</td>
                <td class="master-title">排序</td>
                <td>@Model.Mas?.no_sort</td>
            </tr>

            <tr>
                <td class="master-title">備註</td>
                <td colspan="3">@Model.Mas?.remark</td>
            </tr>
        </tbody>
    </table>

</div>

<hr>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Detail 資料</h2>
    <a class="btn btn-success " asp-action="CreateDet" asp-route-parentno="@Model.Mas?.mno">
        <i class="bi bi-plus-circle"></i>
        新增 Detail
    </a>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-hover detail-table align-middle">
        <thead class="table-primary">
            <tr>
                <th class="w50">@Html.DisplayNameFor(model => model.DetList[0].is_enabled)</th>
                <th class="w50">@Html.DisplayNameFor(model => model.DetList[0].mno)</th>
                <th class="w180">@Html.DisplayNameFor(model => model.DetList[0].mname)</th>
                <th class="w50">@Html.DisplayNameFor(model => model.DetList[0].no_sort)</th>
                <th class="w180">@Html.DisplayNameFor(model => model.DetList[0].url)</th>
                <th class="w120">@Html.DisplayNameFor(model => model.DetList[0].routename)</th>
                <th class="w180">@Html.DisplayNameFor(model => model.DetList[0].remark)</th>
                <th>功能</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.DetList)
            {
                <tr>
                    <td>@Html.DisplayFor(x => item.is_enabled)</td>
                    <td>@item.mno</td>
                    <td>@item.mname</td>
                    <td>@item.no_sort</td>
                    <td>@item.url</td>
                    <td>@item.routename</td>
                    <td>@item.remark</td>
                    <td>
                        <a asp-action="EditDet" asp-route-id="@item.rowid" class="btn btn-warning btn-sm">修改</a>
                        <a asp-action="DeleteDet" asp-route-id="@item.rowid" class="btn btn-danger btn-sm">刪除</a>
                    </td>

                </tr>
            }
        </tbody>

    </table>
</div>

<a asp-action="List" class="btn btn-secondary">
    回 Master
</a>