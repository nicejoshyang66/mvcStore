@model mvc_Dapper.Models.Entity.z_sys_program

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>z_sys_program</h4>
    <hr>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.rowid)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.rowid)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.is_enabled)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.is_enabled)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.mno)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.mno)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.mname)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.mname)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.code_no)
        </dt>

        <dd class="col-sm-10">
            @{
                string? codeName = "";
                if (Model.code_no == "U")
                {
                    codeName = "一般使用者";
                }
                else if (Model.code_no == "M")
                {
                    codeName = "資訊管理員";
                }
                else
                {
                    codeName = Model.code_no;
                }
            }
            @codeName
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.no_sort)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.no_sort)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.remark)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.remark)
        </dd>

    </dl>
    
    <form asp-action="Delete">
        <input type="submit" value="Delete" class="btn btn-danger">
        <a asp-action="List">Back to List</a>
    </form>

</div>