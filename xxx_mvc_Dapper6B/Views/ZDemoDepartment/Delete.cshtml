@model mvc_Dapper.Models.Entity.z_demo_department

@{
    ViewData["Title"] = "刪除部門資料";
}

<h3 class="mb-3 text-danger">刪除部門資料</h3>

<div class="alert alert-danger">
    確定要刪除這筆部門資料嗎？
</div>

<div class="card">
    <div class="card-body">

        <div class="mb-3 row">
            <label class="col-sm-2 col-form-label">RowId</label>
            <div class="col-sm-10">
                <input asp-for="rowid" class="form-control" readonly />
            </div>
        </div>

        <div class="mb-3 row">
            <label asp-for="mno" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="mno" class="form-control" readonly />
            </div>
        </div>

        <div class="mb-3 row">
            <label asp-for="mname" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="mname" class="form-control" readonly />
            </div>
        </div>

        <div class="mb-3 row">
            <label asp-for="remark" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <textarea asp-for="remark" class="form-control" rows="4" readonly></textarea>
            </div>
        </div>

        <form asp-action="DeleteConfirm" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="rowid" value="@Model.rowid" />

            <button type="submit" class="btn btn-danger">
                確定刪除
            </button>

            <a asp-action="List" class="btn btn-secondary">
                取消
            </a>
        </form>

    </div>
</div>