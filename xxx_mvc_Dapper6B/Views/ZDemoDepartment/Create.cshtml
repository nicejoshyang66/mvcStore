
@model mvc_Dapper.Models.Entity.z_demo_department

@{
    ViewData["Title"] = "新增部門資料";
}

<h3 class="mb-3">新增部門資料</h3>

<form asp-action="Create" method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card">
        <div class="card-body">

            <div class="mb-3 row">
                <label asp-for="mno" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <input asp-for="mno" class="form-control" />
                    <span asp-validation-for="mno" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3 row">
                <label asp-for="mname" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <input asp-for="mname" class="form-control" />
                    <span asp-validation-for="mname" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3 row">
                <label asp-for="remark" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10">
                    <textarea asp-for="remark" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="remark" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    儲存
                </button>

                <a asp-action="List" class="btn btn-secondary">
                    回清單
                </a>
            </div>

        </div>
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}