@model mvc_Dapper.Models.Entity.z_demo_employee_school

@{
    ViewData["Title"] = "編輯學歷";
}

<h3 class="mb-3">編輯學歷</h3>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="rowid" />

    @await Html.PartialAsync("_Form", Model)

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">儲存</button>

        <a asp-action="List" asp-route-employeeNo="@Model.employee_no" class="btn btn-secondary">
            返回
        </a>
    </div>
</form>