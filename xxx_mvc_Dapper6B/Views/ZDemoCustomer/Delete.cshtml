@model mvc_Dapper.Models.Entity.z_demo_customer

@{
    ViewData["Title"] = "刪除客戶";
}

<h3 class="mb-3 text-danger">刪除客戶</h3>

<div class="alert alert-warning">
    確定要刪除這筆客戶資料嗎？
</div>

<table class="table table-bordered">
    <tr>
        <th style="width:160px;">序號</th>
        <td>@Model.rowid</td>
    </tr>

    <tr>
        <th>客戶編號</th>
        <td>@Model.mno</td>
    </tr>

    <tr>
        <th>客戶簡稱</th>
        <td>@Model.msname</td>
    </tr>

    <tr>
        <th>客戶名稱</th>
        <td>@Model.mname</td>
    </tr>

    <tr>
        <th>統一編號</th>
        <td>@Model.no_serial</td>
    </tr>

    <tr>
        <th>電話</th>
        <td>@Model.tel_company</td>
    </tr>

    <tr>
        <th>負責人</th>
        <td>@Model.name_charge</td>
    </tr>

    <tr>
        <th>聯絡人</th>
        <td>@Model.name_contact</td>
    </tr>
</table>

<form asp-action="DeleteConfirm" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="rowid" value="@Model.rowid" />

    <button type="submit" class="btn btn-danger">
        確定刪除
    </button>

    <a asp-action="List" class="btn btn-secondary">
        取消
    </a>
</form>