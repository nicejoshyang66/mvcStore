@{
    ViewData["Title"] = "首頁";
}

<div class="container-fluid">

    <!-- 歡迎區 -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center flex-wrap">

                <div>
                    <h2 class="mb-2">
                        <i class="fas fa-home text-primary"></i>
                         ERP 管理系統
                    </h2>

                    <div class="text-muted mb-1">
                        今日日期：
                        @DateTime.Now.ToString("yyyy/MM/dd")
                    </div>

                    <div class="text-muted">
                        登入者：
                        @(Context.Session.GetString("mname") ?? "系統管理員")
                    </div>
                </div>

                <div class="text-center mt-3 mt-md-0">
                    <h1 class="display-4 text-primary fw-bold">
                        Dashboard
                    </h1>
                </div>

            </div>

        </div>
    </div>

    <!-- KPI 卡片 -->
    <div class="row">

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="small-box bg-info shadow-sm">
                <div class="inner">
                    <h3>15</h3>
                    <p>今日待辦事項</p>
                </div>

                <div class="icon">
                    <i class="fas fa-tasks"></i>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="small-box bg-success shadow-sm">
                <div class="inner">
                    <h3>128</h3>
                    <p>本月新增單據</p>
                </div>

                <div class="icon">
                    <i class="fas fa-file-alt"></i>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="small-box bg-warning shadow-sm">
                <div class="inner">
                    <h3>5</h3>
                    <p>待審核資料</p>
                </div>

                <div class="icon">
                    <i class="fas fa-user-check"></i>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="small-box bg-danger shadow-sm">
                <div class="inner">
                    <h3>2</h3>
                    <p>異常警示</p>
                </div>

                <div class="icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- 快捷功能 -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-dark">
            <h3 class="card-title text-white">
                <i class="fas fa-th-large"></i>
                快捷功能
            </h3>
        </div>

        <div class="card-body">

            <div class="row text-center">

                <div class="col-lg-2 col-md-3 col-6 mb-3">
                    <a href="#" class="btn btn-outline-primary w-100 p-3">
                        <i class="fas fa-users fa-2x mb-2"></i>
                        <br />
                        帳戶管理
                    </a>
                </div>

                <div class="col-lg-2 col-md-3 col-6 mb-3">
                    <a href="#" class="btn btn-outline-success w-100 p-3">
                        <i class="fas fa-user-shield fa-2x mb-2"></i>
                        <br />
                        權限管理
                    </a>
                </div>

                <div class="col-lg-2 col-md-3 col-6 mb-3">
                    <a href="#" class="btn btn-outline-info w-100 p-3">
                        <i class="fas fa-search fa-2x mb-2"></i>
                        <br />
                        資料查詢
                    </a>
                </div>

                <div class="col-lg-2 col-md-3 col-6 mb-3">
                    <a href="#" class="btn btn-outline-warning w-100 p-3">
                        <i class="fas fa-chart-bar fa-2x mb-2"></i>
                        <br />
                        報表系統
                    </a>
                </div>

                <div class="col-lg-2 col-md-3 col-6 mb-3">
                    <a href="#" class="btn btn-outline-danger w-100 p-3">
                        <i class="fas fa-calendar-alt fa-2x mb-2"></i>
                        <br />
                        排程管理
                    </a>
                </div>

                <div class="col-lg-2 col-md-3 col-6 mb-3">
                    <a href="#" class="btn btn-outline-secondary w-100 p-3">
                        <i class="fas fa-cogs fa-2x mb-2"></i>
                        <br />
                        系統設定
                    </a>
                </div>

            </div>

        </div>

    </div>

    <div class="row">

        <!-- 最近登入 -->
        <div class="col-lg-6 mb-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-primary">
                    <h3 class="card-title text-white">
                        <i class="fas fa-clipboard-list"></i>
                        今日待辦事項
                    </h3>
                </div>

                <div class="card-body p-0">

                    <table class="table table-hover mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>項目</th>
                                <th>狀態</th>
                                <th>時間</th>
                            </tr>
                        </thead>

                        <tbody>

                            <tr>
                                <td>
                                    待審核請購單
                                </td>

                                <td>
                                    <span class="badge bg-warning">
                                        處理中
                                    </span>
                                </td>

                                <td>
                                    09:00
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    生產排程確認
                                </td>

                                <td>
                                    <span class="badge bg-info">
                                        未開始
                                    </span>
                                </td>

                                <td>
                                    10:30
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    庫存異常檢查
                                </td>

                                <td>
                                    <span class="badge bg-danger">
                                        異常
                                    </span>
                                </td>

                                <td>
                                    13:00
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    部門主管會議
                                </td>

                                <td>
                                    <span class="badge bg-success">
                                        已完成
                                    </span>
                                </td>

                                <td>
                                    15:00
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <!-- 行事曆 -->
        <div class="col-lg-6 mb-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-success">
                    <h3 class="card-title text-white">
                        <i class="fas fa-calendar"></i>
                        系統行事曆
                    </h3>
                </div>

                <div class="card-body">

                    <div id="calendar"></div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script>

        document.addEventListener('DOMContentLoaded', function () {

            var calendarEl = document.getElementById('calendar');

            var calendar = new FullCalendar.Calendar(calendarEl,
            {
                initialView: 'dayGridMonth',

                height: 500,

                locale: 'zh-tw',

                events:
                [
                    @* {
                        title: '待審核請購單',
                        start: '2026-05-15',
                        color: '#f39c12'
                    },

                    {
                        title: '生產排程確認',
                        start: '2026-05-15',
                        color: '#17a2b8'
                    },

                    {
                        title: '庫存異常檢查',
                        start: '2026-05-16',
                        color: '#dc3545'
                    },

                    {
                        title: '部門主管會議',
                        start: '2026-05-18',
                        color: '#28a745'
                    } *@
                ]
            });

            calendar.render();

        });

    </script>
}