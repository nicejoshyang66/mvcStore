@model mvc_Dapper.Models.ViewModel.PoinListVM

@{
    ViewData["Title"] = "進貨資料查詢";
}

<style>
    /* 查詢區標題 */
    .page-title {
        font-size: 1.25rem;
        font-weight: 600;
    }

    /* 統計區：高度縮小 */
    .summary-area {
        padding: 14px 22px;
    }

    .summary-box {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background-color: #f8f9fa;
        min-height: 64px;
        padding: 14px 28px;
        display: flex;
        align-items: center;
    }

    .summary-text {
        font-size: 1.25rem;
        font-weight: 700;
        color: #212529;
    }

    .summary-text.amount {
        color: #dc3545;
    }

    .summary-label {
        color: #333;
        margin-right: 6px;
    }

    /* Grid 隔行淺色背景 */
    .poin-table tbody tr:nth-child(even) td {
        background-color: #f3f6fa !important;
    }

    .poin-table tbody tr:nth-child(odd) td {
        background-color: #ffffff !important;
    }

    .poin-table tbody tr:hover td {
        background-color: #eaf3ff !important;
    }

    .poin-table th {
        white-space: nowrap;
        vertical-align: middle;
        text-align: center;
    }

    .poin-table td {
        vertical-align: middle;
    }

    .result-title {
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 0;
    }
</style>

<div class="container-fluid">

    <!-- 查詢條件 -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-primary text-white">
            <div class="page-title">
                <i class="bi bi-search"></i>
                進貨資料查詢
            </div>
        </div>

        <div class="card-body">
            <form asp-action="List" method="get" class="row g-3 align-items-end">

                <div class="col-md-3">
                    <label asp-for="datefm" class="form-label">日期起</label>
                    <input asp-for="datefm" type="date" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label asp-for="dateto" class="form-label">日期迄</label>
                    <input asp-for="dateto" type="date" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label asp-for="factno" class="form-label">廠商編號</label>
                    <input asp-for="factno" class="form-control" placeholder="空白表示全部" />
                </div>

                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i>
                        查詢
                    </button>

                    <a asp-action="List" class="btn btn-secondary">
                        <i class="bi bi-arrow-clockwise"></i>
                        清除
                    </a>

                    <a asp-action="ExportExcel"
                    asp-route-datefm="@Model.datefm.ToString("yyyy-MM-dd")"
                    asp-route-dateto="@Model.dateto.ToString("yyyy-MM-dd")"
                    asp-route-factno="@Model.factno"
                    class="btn btn-success">
                        <i class="bi bi-file-earmark-excel"></i>
                        下載 EXCEL
                    </a>


                </div>

            </form>
        </div>
    </div>

    <!-- 統計區 -->
    <div class="card shadow-sm mb-3">
        <div class="card-body summary-area">
            <div class="row g-3">

                <div class="col-md-6">
                    <div class="summary-box">
                        <div class="summary-text">
                            <span class="summary-label">筆數：</span>
                            @Model.TotalCount.ToString("N0")
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="summary-box">
                        <div class="summary-text amount">
                            <span class="summary-label">金額加總：</span>
                            @Model.TotalAmount.ToString("N0")
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- 查詢結果 -->
    <div class="card shadow-sm">
        @* <div class="card-header bg-white">
            <div class="result-title">查詢結果</div>
        </div> *@

        <div class="card-body table-responsive p-0">
            <table class="table table-bordered table-hover table-sm mb-0 poin-table">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 160px;">流水編號</th>
                        <th style="width: 130px;">日期</th>
                        <th style="width: 280px;">廠商名稱</th>
                        <th style="width: 160px;">金額</th>
                        <th>備註</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-center">
                                    @item.tran_no
                                </td>

                                <td class="text-center">
                                    @item.po_date.ToString("yyyy-MM-dd")
                                </td>

                                <td>
                                    @item.brief_name
                                </td>

                                <td class="text-end">
                                    @item.tran_amt.ToString("N0")
                                </td>

                                <td>
                                    @item.fact_memo
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted p-4">
                                查無資料
                            </td>
                        </tr>
                    }
                </tbody>

                <tfoot class="table-light">
                    <tr>
                        <th colspan="3" class="text-end">合計</th>
                        <th class="text-end">
                            @Model.TotalAmount.ToString("N0")
                        </th>
                        <th>
                            共 @Model.TotalCount.ToString("N0") 筆
                        </th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

</div>